{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Approved ETF Rotation Target V1",
  "type": "object",
  "required": [
    "schema_version",
    "data_date",
    "generated_at",
    "sleeves",
    "target_weights",
    "approved",
    "model_version",
    "walk_forward_metrics"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "data_date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "generated_at": {"type": "string", "minLength": 10},
    "last_rebalance_week": {"type": "string"},
    "approved": {"const": true},
    "model_version": {"type": "string", "minLength": 1},
    "sleeves": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "array",
        "items": {"type": "string", "pattern": "^\\d{6}$"}
      }
    },
    "target_weights": {
      "type": "object",
      "minProperties": 1,
      "patternProperties": {
        "^\\d{6}$": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
      },
      "additionalProperties": false
    },
    "top_candidates": {"type": "array"},
    "holding_period_trading_days": {"type": "integer", "minimum": 1},
    "rebalance_frequency_trading_days": {"type": "integer", "minimum": 1},
    "walk_forward_metrics": {
      "type": "object",
      "required": ["information_ratio", "cost_model"],
      "properties": {
        "information_ratio": {"type": "number"},
        "cost_model": {
          "type": "object",
          "required": ["commission_rate", "minimum_commission"],
          "properties": {
            "commission_rate": {"const": 0.00015},
            "minimum_commission": {"const": 0.0}
          }
        }
      }
    }
  }
}
