{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://imlam.com/contracts/execution_feedback_history_v1.schema.json",
  "title": "Swing Execution Feedback History V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "event_count", "events"],
  "properties": {
    "schema_version": {"const": 1},
    "generated_at": {"type": "string", "minLength": 10},
    "event_count": {"type": "integer", "minimum": 0, "maximum": 100},
    "events": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "execution_feedback_v1.schema.json"
      }
    }
  }
}
