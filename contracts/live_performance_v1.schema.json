{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://imlam.com/contracts/live_performance_v1.schema.json",
  "title": "Swing Live Performance Versus CSI 300 V1",
  "type": "object",
  "required": [
    "schema_version",
    "performance_id",
    "generated_at",
    "benchmark_code",
    "baseline",
    "observation_count",
    "data_date",
    "model_version",
    "portfolio_state_evidence",
    "pending_broker_confirmation_plan_id",
    "last_execution_satisfied_plan_id",
    "broker_reconciliation_id",
    "total_assets",
    "strategy_nav",
    "benchmark_nav",
    "relative_nav",
    "strategy_return",
    "benchmark_return",
    "excess_return",
    "relative_return",
    "strategy_max_drawdown",
    "benchmark_max_drawdown",
    "relative_max_drawdown",
    "rolling_20",
    "rolling_60",
    "history"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "performance_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "generated_at": {"type": "string", "minLength": 10},
    "benchmark_code": {"const": "510300"},
    "baseline": {"type": "object"},
    "observation_count": {"type": "integer", "minimum": 1},
    "data_date": {"type": "string", "minLength": 10},
    "model_version": {"type": "string"},
    "portfolio_state_evidence": {
      "enum": [
        "BROKER_RECONCILED",
        "MODEL_ESTIMATE_PENDING",
        "NO_EXECUTION_REQUIRED",
        "INITIAL_STATE",
        "LEGACY_UNVERIFIED"
      ]
    },
    "pending_broker_confirmation_plan_id": {"type": "string"},
    "last_execution_satisfied_plan_id": {"type": "string"},
    "broker_reconciliation_id": {"type": "string"},
    "total_assets": {"type": "number", "exclusiveMinimum": 0},
    "strategy_nav": {"type": "number", "exclusiveMinimum": 0},
    "benchmark_nav": {"type": "number", "exclusiveMinimum": 0},
    "relative_nav": {"type": "number", "exclusiveMinimum": 0},
    "strategy_return": {"type": "number"},
    "benchmark_return": {"type": "number"},
    "excess_return": {"type": "number"},
    "relative_return": {"type": "number"},
    "strategy_max_drawdown": {"type": "number", "maximum": 0},
    "benchmark_max_drawdown": {"type": "number", "maximum": 0},
    "relative_max_drawdown": {"type": "number", "maximum": 0},
    "rolling_20": {"type": "object"},
    "rolling_60": {"type": "object"},
    "history": {"type": "array", "maxItems": 520}
  },
  "additionalProperties": false
}
