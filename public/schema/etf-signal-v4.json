{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://etf.imlam.com/schema/etf-signal-v4.json",
  "title": "ETF Signal Payload V4",
  "type": "object",
  "required": ["schema_version", "update_time", "market_policy", "market_breadth", "signals"],
  "properties": {
    "schema_version": {"const": 4},
    "update_time": {"type": "string", "minLength": 10},
    "market_policy": {"type": "object"},
    "market_breadth": {"type": "object"},
    "signals": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/signal"}
    }
  },
  "additionalProperties": true,
  "$defs": {
    "signal": {
      "type": "object",
      "required": ["schema_version", "signal_id", "code", "name", "data_date", "price", "data_quality", "trend", "entry", "relative_strength", "risk", "market_policy", "calibration"],
      "properties": {
        "schema_version": {"const": 4},
        "signal_id": {"type": "string", "minLength": 1},
        "code": {"type": "string", "minLength": 1},
        "name": {"type": "string"},
        "data_date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "price": {"type": "number", "exclusiveMinimum": 0},
        "data_quality": {"type": "object", "required": ["status"]},
        "trend": {"type": "object", "required": ["state"]},
        "entry": {"type": "object", "required": ["state", "setup", "priority"]},
        "relative_strength": {"type": "object"},
        "risk": {"type": "object", "required": ["stop_loss", "executable"]},
        "market_policy": {"type": "object", "required": ["entry_permission", "max_exposure_ratio"]},
        "calibration": {"type": "object", "required": ["approved", "confidence", "version"]}
      },
      "additionalProperties": true
    }
  }
}
